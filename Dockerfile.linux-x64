FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /source

# copy csproj and restore as distinct layers
COPY GenHTTP.Gateway/*.csproj .
RUN dotnet restore -r linux-x64

# copy and publish app and libraries
COPY GenHTTP.Gateway/ . 
RUN dotnet publish -c release -o /app -r linux-x64 --no-restore --self-contained

# final stage/image
# glibc based, as the native libraries of the ioxide engine do not run on musl (alpine)
FROM mcr.microsoft.com/dotnet/runtime-deps:11.0
WORKDIR /app

# libmsquic is required for HTTP/3 on Kestrel
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && . /etc/os-release \
 && curl -fsSL -o /tmp/packages-microsoft-prod.deb https://packages.microsoft.com/config/$ID/$VERSION_ID/packages-microsoft-prod.deb \
 && dpkg -i /tmp/packages-microsoft-prod.deb \
 && rm /tmp/packages-microsoft-prod.deb \
 && apt-get update \
 && apt-get install -y --no-install-recommends libmsquic \
 && apt-get purge -y curl \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /app .

ENTRYPOINT ["./GenHTTP.Gateway"]

ENV DOCKER_FLAVOR=linux

VOLUME ["/app/data", "/app/certs", "/app/config"]

EXPOSE 80 443
